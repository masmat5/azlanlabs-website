# Copy to .env.local for `vercel dev`, and add the same keys in Vercel → Settings → Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=you@yourmail.com
# Use a sender on a domain verified in Resend. For quick tests: onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev
